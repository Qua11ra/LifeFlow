{
    "extends": "@repo/typescript-config/react.json",
    "compilerOptions": {
        "outDir": "./dist",
        "ignoreDeprecations": "6.0", //Strange bug in building with dts
        "baseUrl": "./",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["*.ts", "*.tsx", "components/**/*.ts", "components/**/*.tsx", "*.d.ts"],
    "exclude": ["node_modules", "dist"]
}