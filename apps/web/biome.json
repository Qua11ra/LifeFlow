{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noShadowRestrictedNames": "warn",
                "noDocumentCookie": "warn",
                "noArrayIndexKey": "warn",
                "noDuplicateProperties": "warn",
                "noShorthandPropertyOverrides": "warn"
            },
            "correctness": {
                "noChildrenProp": "warn",
                "noEmptyPattern": "warn"
            },
            "a11y": {
                "useButtonType": "warn",
                "useKeyWithClickEvents": "warn",
                "noSvgWithoutTitle": "warn"
            },
            "style": {
                "noDescendingSpecificity": "warn"
            },
            "complexity": {
                "noImportantStyles": "warn"
            }
        },
        "domains": {
            "next": "recommended",
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
